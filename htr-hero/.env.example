# Server-side only — never shipped to the browser.
# Local dev (`npm run dev`): read by the Vite proxy from this file.
# Vercel production: set the SAME name in Project → Settings → Environment
# Variables (all environments), then redeploy. No VITE_ prefix needed.
TYPESAFE_API_KEY=

# Model used for the fan-out search (public value, safe to expose).
VITE_TYPESAFE_MODEL=jev-latest
